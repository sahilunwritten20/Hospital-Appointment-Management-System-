# Copy this file to server/.env and fill in your own MongoDB connection
# string (MongoDB Atlas free tier works fine). This is the ONLY value
# you need to set before deploying.

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lifecare?retryWrites=true&w=majority

# Optional — most hosts (Render, Railway, etc.) set this for you.
PORT=3000
